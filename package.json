    "@sentry/react-native": "8.13.0",
    "@tanstack/react-query": "5.101.4",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.8",
    "expo-auth-session": "~57.0.5",
    "expo-build-properties": "~57.0.7",
    "expo-camera": "~57.0.3",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.8",
