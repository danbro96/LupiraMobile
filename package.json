    "regen:api": "npm run fetch:openapi && npm run generate:api"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/bottom-tabs": "7.16.2",
    "@react-navigation/native": "7.2.5",
    "@react-navigation/native-stack": "7.16.0",
    "@sentry/react-native": "8.13.0",
    "@tanstack/react-query": "5.101.0",
    "babel-preset-expo": "~56.0.0",
    "expo": "56.0.8",
    "expo-audio": "~56.0.11",
    "expo-build-properties": "~56.0.0",
    "expo-camera": "~56.0.7",
    "expo-dev-client": "~56.0.0",
    "expo-file-system": "~56.0.7",
    "expo-image-manipulator": "~56.0.0",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-fast-opencv": "0.4.8",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-vision-camera": "5.0.11",
    "react-native-vision-camera-worklets": "5.0.11",
    "react-native-worklets": "0.9.1",
    "zustand": "5.0.14"
