{
  "name": "lupiramtgmobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch:openapi": "node scripts/fetch-openapi.mjs",
    "fetch:symbols": "node scripts/fetch-symbols.mjs",
    "generate:api": "orval --config ./orval.config.ts",
    "regen:api": "npm run fetch:openapi && npm run generate:api"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/bottom-tabs": "7.16.2",
    "@react-navigation/native": "7.2.5",
    "@react-navigation/native-stack": "7.16.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "5.103.2",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.25",
    "expo-auth-session": "~57.0.13",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.5",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-fast-opencv": "0.4.8",
    "react-native-paper": "5.15.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-vision-camera": "5.0.11",
    "react-native-vision-camera-worklets": "5.0.11",
    "react-native-worklets": "0.10.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "orval": "8.37.0",
    "typescript": "~7.0.2",
