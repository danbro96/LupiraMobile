{
  "expo": {
    "name": "Lupira MTG",
    "slug": "lupiramtg",
    "scheme": "lupiramtg",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": { "policy": "fingerprint" },
    "updates": { "url": "https://u.expo.dev/6f9cc1b4-b47b-49bc-b634-6bcf96bb8a0c" },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Lupira MTG needs the camera to scan Magic: The Gathering cards."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.lupira.mtg"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Lupira MTG needs the camera to scan Magic: The Gathering cards."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "project": "lupira-mtg",
          "organization": "brostrom"
        }
      ],
      "expo-image"
    ],
    "extra": {
      "eas": {
        "projectId": "6f9cc1b4-b47b-49bc-b634-6bcf96bb8a0c"
      }
    },
    "owner": "danbro96"
  }
}
